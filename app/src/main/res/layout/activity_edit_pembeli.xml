<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">


    <EditText
        android:id="@+id/editNamaPembeli"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nama Pembeli"
        android:inputType="text" />


    <EditText
        android:id="@+id/editAlamatPembeli"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Alamat Pembeli"
        android:inputType="text" />


    <EditText
        android:id="@+id/editTelpPembeli"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="No. Telp Pembeli"
        android:inputType="phone" />


    <Button
        android:id="@+id/tombolupdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#800000"
        android:text="Update" />


    <Button
        android:id="@+id/tombolbatal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#800000"
        android:text="Batal" />

</LinearLayout>