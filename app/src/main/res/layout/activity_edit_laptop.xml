<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">


    <EditText
        android:id="@+id/editmerk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="merk laptop"
        android:inputType="text" />


    <EditText
        android:id="@+id/editType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="type laptop"
        android:inputType="text" />

    <EditText
        android:id="@+id/editWarna"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="warna laptop"
        android:inputType="text" />

    <EditText
        android:id="@+id/editharga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Harga Laptop"
        android:inputType="number" />

    <Button
        android:id="@+id/tombolupdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#800000"
        android:text="Update" />

    <Button
        android:id="@+id/tombolbatal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#800000"
        android:text="Batal" />

</LinearLayout>